# ==========================================================================
# .env.example —— 环境变量清单（模板，会进仓库）
#
# 怎么用：
#   复制一份，改名 .env.local（或 .env），把等号右边填上你自己的值。
#   Git 不会跟踪 .env、.env.*（.gitignore 第 19–26 行已经写死），
#   只有**这个文件**本身会进仓库 —— 所以它里面只允许出现字段名，不许出现真实值。
#
# 先说清楚一件事（Day 23 实测，不夸大它的作用）：
#   本项目现在的代码**不会自动读取这个文件**。
#     · 前端接口地址在 api.js 里是写死的常量；
#     · 云函数读的是 CloudBase 控制台里配的环境变量，不是本地文件。
#   所以它现在的作用是「换台电脑、或者交接给别人时，照着填的清单」，
#   不是程序会去加载的配置。等以后接了能自动读 .env 的构建工具，这份清单就是它的输入。
# ==========================================================================


# --------------------------------------------------------------------------
# 一、云端：CloudBase 云函数的环境变量
#     在云函数控制台的「环境变量」里配，**不要填在本地文件里**。
#     这里有值也不会被读到，写在这儿只是登记名字。
# --------------------------------------------------------------------------

# 环境 ID。代码里已带默认值，不配也能跑（cloudfunctions/_shared/rdb.js）
TCB_ENV=

# 下面四个是 AI 服务用的（阶段二才接，TECH_DESIGN 7.1 已登记）。
# 密钥只存在于云端这一段，浏览器全程拿不到（对应 PRD AC10）。
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=
AI_API_KEY=


# --------------------------------------------------------------------------
# 二、本地：前端请求地址
#     目前 api.js 里是写死的常量，填了也不会被读取；
#     等前端改成从环境变量取地址时，这一行才会真正生效。
# --------------------------------------------------------------------------

VITE_API_BASE=
