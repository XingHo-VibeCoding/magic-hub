# ==========================================================================
# .gitignore —— 告诉 Git「这些文件不要跟踪、不要上传到 GitHub」
#
# 语法三件事：
#   1. 一行 = 一条规则；写文件名或文件夹名（文件夹记着结尾加 /）
#   2. # 开头是注释，Git 不看
#   3. ! 开头是「反向例外」，意思是「虽然上面忽略了，但这个要留下」
#
# 重要：这份文件必须在第一次提交之前就存在。否则已经被跟踪的文件，
#       事后补规则也不管用（历史里还是留着）。
# ==========================================================================


# --------------------------------------------------------------------------
# 1. 环境变量 / 机密文件 —— 最重要，永远放最前面
#    .env 是本地存数据库密码、API 密钥这类配置的文件。
#    第 23 天才会用到它，现在先把规则立好，防止以后手一滑传上去。
# --------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
.env.local
.env.development
.env.production
.env.test


# --------------------------------------------------------------------------
# 2. 密钥 / 证书 / 凭据文件
# --------------------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
secrets.json
secret.json
credentials.json
credentials*.json
serviceaccount*.json
config.local.*


# --------------------------------------------------------------------------
# 3. 依赖目录 —— 体积巨大（动辄几万个小文件），永远不要上传
#    换台电脑时用 npm install / pip install 重新装就行
# --------------------------------------------------------------------------
node_modules/
bower_components/
jspm_packages/
site-packages/
__pypackages__/
.venv/
venv/
env/
ENV/


# --------------------------------------------------------------------------
# 4. 本地数据库文件 —— 里面可能有比赛数据、个人数据，不该进公开仓库
# --------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal
*.mdb
*.accdb
*.dbf
*.frm
*.ibd
*.myd
*.myi
*.ldf
dump.sql
*.dump
data/local/
db/local/


# --------------------------------------------------------------------------
# 5. 构建产物 / 缓存 / 日志 —— 都是能重新生成的中间产物
# --------------------------------------------------------------------------
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
tmp/
temp/
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo


# --------------------------------------------------------------------------
# 6. 操作系统与编辑器的杂项垃圾
# --------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.history/


# --------------------------------------------------------------------------
# 7. Python 相关（数学建模大概率会用到）
# --------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
*.ipynb.bak


# --------------------------------------------------------------------------
# 8. 大体积资料 / 私人材料（默认注释掉，需要时自己打开）
#    竞赛原始资料、扫描件、视频动辄几百 MB，塞进仓库会让克隆变得极慢。
#    这类东西建议放网盘，仓库里只留链接和文字说明。
# --------------------------------------------------------------------------
# contest-archive/
# *.zip
# *.rar
# *.7z
# *.pdf
# *.mp4
